#!/bin/sh
# The Sikarugir launcher runs this on every launch of the app, before Wine starts.
CONTENTSFOLD=$(cd "$(dirname "$0")/../.." && pwd)
SCRIPTS="$CONTENTSFOLD/Resources/Scripts"

"$SCRIPTS/reshim-steamwebhelper.sh" "$CONTENTSFOLD"

# Switch to the game's icon once the game is installed (no-op after the first time).
"$SCRIPTS/make-icon.sh" "$CONTENTSFOLD" >/dev/null 2>&1 &

# Shows Steam's Downloads page during installs, quits Steam when the game exits.
nohup "$SCRIPTS/steam-session.sh" "$CONTENTSFOLD" >/dev/null 2>&1 &
